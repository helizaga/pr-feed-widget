#!/usr/bin/env bash
set -euo pipefail

PR_AGENT_HOME="${PR_AGENT_HOME:-$HOME/.pr-agent}"
PR_AGENT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
CONFIG_FILE="$PR_AGENT_HOME/config.yaml"
STATE_FILE="$PR_AGENT_HOME/state.json"
SESSIONS_DIR="$PR_AGENT_HOME/sessions"
LOG_FILE="$PR_AGENT_HOME/webhook.log"
PID_FILE="$PR_AGENT_HOME/webhook.pid"

source "$PR_AGENT_DIR/bin/lib-config.sh"

mkdir -p "$PR_AGENT_HOME" "$SESSIONS_DIR"

# Read config
WEBHOOK_PORT=$(_config_value "webhook_port")
WEBHOOK_PORT="${WEBHOOK_PORT:-9867}"
WEBHOOK_HOST=$(_config_value "webhook_host")
WEBHOOK_HOST="${WEBHOOK_HOST:-127.0.0.1}"
WEBHOOK_SECRET=$(_config_value "webhook_secret")
ORG=$(_config_value "github_org")

if [[ -z "$ORG" ]]; then
    echo "ERROR: github_org not set in config" >&2
    exit 1
fi

_log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [webhook] $*" | tee -a "$LOG_FILE"
}

_log "Starting webhook server on port $WEBHOOK_PORT"

# Write PID file (exec replaces this process, so PID stays the same)
echo $$ > "$PID_FILE"

# Launch embedded Python HTTP server (exec replaces bash, Python handles cleanup)
exec python3 - "$WEBHOOK_PORT" "$WEBHOOK_SECRET" "$ORG" "$PR_AGENT_DIR" "$PR_AGENT_HOME" "$STATE_FILE" "$SESSIONS_DIR" "$LOG_FILE" "$PID_FILE" "$WEBHOOK_HOST" << 'PYTHON_EOF'
import sys
import os
import json
import hmac
import hashlib
import subprocess
import signal
from http.server import HTTPServer, BaseHTTPRequestHandler
from datetime import datetime, timezone
from threading import Thread, Lock

WEBHOOK_PORT = int(sys.argv[1])
WEBHOOK_SECRET = sys.argv[2]
ORG = sys.argv[3]
PR_AGENT_DIR = sys.argv[4]
PR_AGENT_HOME = sys.argv[5]
STATE_FILE = sys.argv[6]
SESSIONS_DIR = sys.argv[7]
LOG_FILE = sys.argv[8]
PID_FILE = sys.argv[9]
WEBHOOK_HOST = sys.argv[10] if len(sys.argv) > 10 else "127.0.0.1"

# Locks for thread-safe file access
_state_lock = Lock()          # guards state.json reads/writes
_pr_locks = {}                # per-PR-key locks for meta.json
_pr_locks_guard = Lock()      # guards the _pr_locks dictionary itself


def _get_pr_lock(pr_key):
    """Get or create a per-PR Lock for serializing meta.json access."""
    with _pr_locks_guard:
        if pr_key not in _pr_locks:
            _pr_locks[pr_key] = Lock()
        return _pr_locks[pr_key]


def log(msg):
    line = f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] [webhook] {msg}"
    print(line, flush=True)
    try:
        with open(LOG_FILE, "a") as f:
            f.write(line + "\n")
    except Exception:
        pass


def is_seen(pr_key):
    with _state_lock:
        try:
            with open(STATE_FILE) as f:
                state = json.load(f)
            return pr_key in state.get("seen_prs", {})
        except Exception:
            return False


def mark_seen(pr_key):
    with _state_lock:
        try:
            with open(STATE_FILE) as f:
                state = json.load(f)
        except Exception:
            state = {"seen_prs": {}, "last_poll": None}

        state.setdefault("seen_prs", {})[pr_key] = datetime.now(timezone.utc).isoformat()
        with open(STATE_FILE, "w") as f:
            json.dump(state, f, indent=2)


def is_skip_repo(repo):
    config_file = os.path.join(PR_AGENT_HOME, "config.yaml")
    try:
        in_skip = False
        with open(config_file) as f:
            for line in f:
                if line.startswith("skip_repos:"):
                    in_skip = True
                    continue
                if in_skip:
                    if line.startswith("  - "):
                        if line.strip().lstrip("- ").strip() == repo:
                            return True
                    elif not line.startswith(" "):
                        break
    except Exception:
        pass
    return False


def verify_signature(payload, signature):
    if not WEBHOOK_SECRET:
        return True
    if not signature:
        return False
    expected = "sha256=" + hmac.new(
        WEBHOOK_SECRET.encode(), payload, hashlib.sha256
    ).hexdigest()
    return hmac.compare_digest(expected, signature)


def stop_and_update_session(pr_key, new_status, merged_at=None):
    """Stop any active review process for a PR and update its status."""
    session_dir = os.path.join(SESSIONS_DIR, pr_key)
    meta_file = os.path.join(session_dir, "meta.json")

    if not os.path.exists(meta_file):
        log(f"No session for {pr_key}, nothing to stop")
        return

    lock = _get_pr_lock(pr_key)
    with lock:
        try:
            with open(meta_file) as f:
                meta = json.load(f)
        except Exception:
            return

        # Kill active review process if running
        pid = meta.get("pid")
        if pid and str(pid) != "None":
            try:
                pid = int(pid)
                # Verify the process is ours before killing (PID may have been recycled)
                result = subprocess.run(
                    ["ps", "-p", str(pid), "-o", "args="],
                    capture_output=True, text=True, timeout=5
                )
                cmd = result.stdout.strip()
                if "claude" in cmd or "pr-agent" in cmd:
                    os.killpg(os.getpgid(pid), signal.SIGTERM)
                    log(f"Killed review process {pid} for {pr_key}")
                else:
                    log(f"PID {pid} for {pr_key} not a review process (recycled?), skipping kill")
            except (ProcessLookupError, PermissionError, OSError, subprocess.TimeoutExpired):
                pass

        meta["status"] = new_status
        if merged_at:
            meta["merged_at"] = merged_at
        meta["closed_at"] = datetime.now(timezone.utc).isoformat()
        with open(meta_file, "w") as f:
            json.dump(meta, f, indent=2)
        log(f"Updated {pr_key} status to {new_status}")


def spawn_review(pr_key, pr_url, title, repo, pr_num, author, created_at):
    review_script = os.path.join(PR_AGENT_DIR, "bin", "pr-agent-review")
    try:
        subprocess.Popen(
            [review_script, pr_key, pr_url, title, repo, str(pr_num), author, created_at],
            cwd=PR_AGENT_DIR,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        log(f"Spawned review for {repo}#{pr_num}")
    except Exception as e:
        log(f"ERROR spawning review for {repo}#{pr_num}: {e}")


def resume_session(pr_key, reason, details):
    """Resume an existing review session with new context.

    Finds the session's Claude session_id and review_clone, then runs
    claude --resume with a follow-up prompt about the new activity.
    Uses per-PR locking to prevent concurrent resumes of the same session.
    """
    session_dir = os.path.join(SESSIONS_DIR, pr_key)
    meta_file = os.path.join(session_dir, "meta.json")

    lock = _get_pr_lock(pr_key)
    with lock:
        try:
            with open(meta_file) as f:
                meta = json.load(f)
        except Exception:
            log(f"Cannot resume {pr_key}: no meta.json")
            return

        session_id = meta.get("session_id")
        review_clone = meta.get("review_clone")
        status = meta.get("status", "")

        # Only resume completed reviews — lock ensures no race with concurrent events
        if status not in ("ready", "posted", "in-progress"):
            log(f"Skipping resume for {pr_key}: status is '{status}'")
            return

        if not session_id or session_id == "None":
            log(f"Cannot resume {pr_key}: no session_id")
            return

        if not review_clone or not os.path.isdir(review_clone):
            log(f"Cannot resume {pr_key}: review_clone '{review_clone}' is missing or inaccessible")
            return
        work_dir = review_clone

        prompt = f"""New activity on this PR since your last review:

{reason}: {details}

Please review the new changes/comments. If there are new commits, fetch the updated diff:
  git fetch origin && git diff HEAD...FETCH_HEAD

If there are new comments that need a response, draft a reply.

Update your review assessment if needed."""

        # Spawn process and write status+PID atomically under lock
        meta["status"] = "reviewing"
        meta["review_started_at"] = datetime.now(timezone.utc).isoformat()
        try:
            proc = subprocess.Popen(
                ["claude", "--resume", session_id, "-p", prompt, "--permission-mode", "bypassPermissions"],
                cwd=work_dir,
                stdout=open(os.path.join(session_dir, "re-review.md"), "w"),
                stderr=open(os.path.join(session_dir, "claude-stderr.log"), "a"),
                start_new_session=True,
                env={k: v for k, v in os.environ.items() if k != "CLAUDECODE"},
            )
            meta["pid"] = proc.pid
            with open(meta_file, "w") as f:
                json.dump(meta, f, indent=2)
            log(f"Resumed session for {pr_key} (reason: {reason}, pid: {proc.pid})")

        except Exception as e:
            log(f"ERROR resuming session for {pr_key}: {e}")
            meta["status"] = "ready"  # revert
            with open(meta_file, "w") as f:
                json.dump(meta, f, indent=2)
            return

    # Wait in a separate thread (lock released, so other operations can proceed)
    def _wait():
        rc = proc.wait()
        with lock:
            try:
                with open(meta_file) as f:
                    m = json.load(f)
                m["status"] = "ready" if rc == 0 else "failed"
                m["pid"] = None
                m["review_completed_at"] = datetime.now(timezone.utc).isoformat()
                with open(meta_file, "w") as f:
                    json.dump(m, f, indent=2)
                if rc != 0:
                    log(f"Resume process for {pr_key} exited with code {rc}")
            except Exception as e:
                log(f"Error updating meta after resume for {pr_key}: {e}")
    Thread(target=_wait, daemon=True).start()


class WebhookHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def do_GET(self):
        if self.path == "/health":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"status": "ok", "port": WEBHOOK_PORT}).encode())
            return
        self.send_response(404)
        self.end_headers()

    def do_POST(self):
        if self.path != "/webhook":
            self.send_response(404)
            self.end_headers()
            return

        MAX_PAYLOAD = 10 * 1024 * 1024  # 10 MB
        content_length = int(self.headers.get("Content-Length", 0))
        if content_length == 0:
            self.send_response(400)
            self.end_headers()
            self.wfile.write(b"Empty request body")
            return
        if content_length > MAX_PAYLOAD:
            log(f"Rejected oversized payload: {content_length} bytes")
            self.send_response(413)
            self.end_headers()
            self.wfile.write(b"Payload too large")
            return

        payload = self.rfile.read(content_length)

        # Verify signature
        signature = self.headers.get("X-Hub-Signature-256", "")
        if not verify_signature(payload, signature):
            log("Rejected request: invalid signature")
            self.send_response(401)
            self.end_headers()
            self.wfile.write(b"Invalid signature")
            return

        try:
            data = json.loads(payload)
        except json.JSONDecodeError:
            log("Rejected request: invalid JSON")
            self.send_response(400)
            self.end_headers()
            self.wfile.write(b"Invalid JSON payload")
            return

        event = self.headers.get("X-GitHub-Event", "")

        if event == "ping":
            log("Received ping event")
            self._respond(200, {"msg": "pong"})
            return

        if event == "pull_request":
            action = data.get("action", "")
            self._handle_pr_event(data, action)
            self._respond(200, {"msg": "ok", "event": "pull_request", "action": action})
            return

        if event == "issue_comment":
            action = data.get("action", "")
            self._handle_comment_event(data, action)
            self._respond(200, {"msg": "ok", "event": "issue_comment", "action": action})
            return

        if event == "pull_request_review":
            action = data.get("action", "")
            self._handle_review_event(data, action)
            self._respond(200, {"msg": "ok", "event": "pull_request_review", "action": action})
            return

        if event == "pull_request_review_comment":
            action = data.get("action", "")
            self._handle_review_comment_event(data, action)
            self._respond(200, {"msg": "ok", "event": "pull_request_review_comment", "action": action})
            return

        log(f"Ignoring event type: {event}")
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"Event ignored")

    def _respond(self, code, body):
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(json.dumps(body).encode())

    def _handle_pr_event(self, data, action):
        handled = ("opened", "synchronize", "closed", "reopened",
                   "ready_for_review", "converted_to_draft")
        if action not in handled:
            log(f"Ignoring pull_request action: {action}")
            return

        try:
            pr = data["pull_request"]
            pr_num = pr["number"]
            repo = data["repository"]["name"]
            repo_org = data["repository"]["owner"]["login"]
        except (KeyError, TypeError) as e:
            log(f"ERROR parsing PR event: missing field {e}")
            return

        if repo_org != ORG:
            log(f"Ignoring PR from different org: {repo_org} (expected {ORG})")
            return

        if is_skip_repo(repo):
            log(f"Skipping repo: {repo}")
            return

        pr_key = f"{ORG}-{repo}-{pr_num}"

        if action == "closed":
            merged = pr.get("merged", False)
            new_status = "merged" if merged else "dismissed"
            log(f"PR {repo}#{pr_num} {'merged' if merged else 'closed'}")
            stop_and_update_session(pr_key, new_status, pr.get("merged_at"))
            return

        if action == "converted_to_draft":
            log(f"PR {repo}#{pr_num} converted to draft, stopping review")
            stop_and_update_session(pr_key, "dismissed")
            return

        # Fields needed for opened/synchronize/reopened/ready_for_review
        try:
            title = pr["title"]
            author = pr["user"]["login"]
            pr_url = pr["html_url"]
            created_at = pr["created_at"]
        except (KeyError, TypeError) as e:
            log(f"ERROR parsing PR event: missing field {e}")
            return

        # Skip draft PRs (opened as draft)
        if action == "opened" and pr.get("draft", False):
            log(f"Ignoring draft PR: {repo}#{pr_num}")
            return

        # reopened or ready_for_review — treat like opened if not already seen
        if action in ("reopened", "ready_for_review"):
            if is_seen(pr_key):
                # Already have a session — resume it instead
                reason = "PR reopened" if action == "reopened" else "PR marked ready for review"
                log(f"{reason}: {repo}#{pr_num}")
                Thread(
                    target=resume_session,
                    args=(pr_key, reason, f"The PR is now active again. Re-check the latest state."),
                    daemon=True,
                ).start()
                return
            # Fall through to the "opened" path below
            log(f"{'Reopened' if action == 'reopened' else 'Ready for review'} PR: {repo}#{pr_num} (new)")
            action = "opened"

        if action == "opened":
            if is_seen(pr_key):
                log(f"PR {repo}#{pr_num} already seen, skipping")
                return

            log(f"New PR via webhook: {repo}#{pr_num} - {title} (by {author})")
            mark_seen(pr_key)

            # Write meta.json so the UI shows the PR immediately
            session_dir = os.path.join(SESSIONS_DIR, pr_key)
            os.makedirs(session_dir, exist_ok=True)
            meta = {
                "pr_key": pr_key, "pr_url": pr_url, "pr_number": pr_num,
                "repo": repo, "org": ORG, "title": title, "author": author,
                "created_at": created_at,
                "review_started_at": datetime.now(timezone.utc).isoformat(),
                "status": "reviewing", "session_id": None, "pid": None,
                "trigger": "webhook", "priority": "normal",
            }
            with open(os.path.join(session_dir, "meta.json"), "w") as f:
                json.dump(meta, f, indent=2)

            Thread(
                target=spawn_review,
                args=(pr_key, pr_url, title, repo, str(pr_num), author, created_at),
                daemon=True,
            ).start()

        elif action == "synchronize":
            # New commits pushed — resume existing session with updated context
            log(f"PR {repo}#{pr_num} updated (new commits)")
            commits = data.get("pull_request", {}).get("commits", "?")
            Thread(
                target=resume_session,
                args=(pr_key, "New commits pushed", f"{commits} commits now on this PR. Review the new changes."),
                daemon=True,
            ).start()

    def _handle_comment_event(self, data, action):
        if action != "created":
            log(f"Ignoring issue_comment action: {action}")
            return

        # Only handle comments on PRs (issue_comment fires for both issues and PRs)
        issue = data.get("issue", {})
        if "pull_request" not in issue:
            return

        try:
            pr_num = issue["number"]
            repo = data["repository"]["name"]
            repo_org = data["repository"]["owner"]["login"]
            comment_author = data["comment"]["user"]["login"]
            comment_body = data["comment"]["body"]
        except (KeyError, TypeError) as e:
            log(f"ERROR parsing comment event: missing field {e}")
            return

        if repo_org != ORG:
            return

        if is_skip_repo(repo):
            return

        # Ignore bot comments (CodeRabbit, github-actions, etc.)
        if "[bot]" in comment_author:
            log(f"Ignoring bot comment from {comment_author} on {repo}#{pr_num}")
            return

        pr_key = f"{ORG}-{repo}-{pr_num}"
        session_dir = os.path.join(SESSIONS_DIR, pr_key)

        if not os.path.exists(os.path.join(session_dir, "meta.json")):
            log(f"Comment on {repo}#{pr_num} but no session exists, ignoring")
            return

        # Truncate long comments for the prompt
        body_preview = comment_body[:500] + "..." if len(comment_body) > 500 else comment_body

        log(f"New comment on {repo}#{pr_num} by {comment_author}")
        Thread(
            target=resume_session,
            args=(pr_key, f"New comment by {comment_author}", body_preview),
            daemon=True,
        ).start()

    def _handle_review_event(self, data, action):
        """Handle pull_request_review events (someone submitted a formal review)."""
        if action != "submitted":
            return

        try:
            pr_num = data["pull_request"]["number"]
            repo = data["repository"]["name"]
            repo_org = data["repository"]["owner"]["login"]
            reviewer = data["review"]["user"]["login"]
            review_state = data["review"]["state"]  # approved, changes_requested, commented
            review_body = data["review"].get("body") or ""
        except (KeyError, TypeError) as e:
            log(f"ERROR parsing review event: missing field {e}")
            return

        if repo_org != ORG:
            return
        if "[bot]" in reviewer:
            return

        pr_key = f"{ORG}-{repo}-{pr_num}"
        session_dir = os.path.join(SESSIONS_DIR, pr_key)
        if not os.path.exists(os.path.join(session_dir, "meta.json")):
            return

        body_preview = review_body[:500] + "..." if len(review_body) > 500 else review_body
        detail = f"Review state: {review_state}"
        if body_preview:
            detail += f"\n\n{body_preview}"

        log(f"Review {review_state} on {repo}#{pr_num} by {reviewer}")
        Thread(
            target=resume_session,
            args=(pr_key, f"Review ({review_state}) by {reviewer}", detail),
            daemon=True,
        ).start()

    def _handle_review_comment_event(self, data, action):
        """Handle pull_request_review_comment events (inline code comments)."""
        if action != "created":
            return

        try:
            pr_num = data["pull_request"]["number"]
            repo = data["repository"]["name"]
            repo_org = data["repository"]["owner"]["login"]
            commenter = data["comment"]["user"]["login"]
            comment_body = data["comment"]["body"]
            diff_hunk = data["comment"].get("diff_hunk", "")
            path = data["comment"].get("path", "")
        except (KeyError, TypeError) as e:
            log(f"ERROR parsing review comment event: missing field {e}")
            return

        if repo_org != ORG:
            return
        if "[bot]" in commenter:
            return

        pr_key = f"{ORG}-{repo}-{pr_num}"
        session_dir = os.path.join(SESSIONS_DIR, pr_key)
        if not os.path.exists(os.path.join(session_dir, "meta.json")):
            return

        body_preview = comment_body[:400] + "..." if len(comment_body) > 400 else comment_body
        detail = f"File: {path}\n\n{body_preview}"

        log(f"Inline comment on {repo}#{pr_num} by {commenter} ({path})")
        Thread(
            target=resume_session,
            args=(pr_key, f"Inline comment by {commenter} on {path}", detail),
            daemon=True,
        ).start()


def run_server():
    server = HTTPServer((WEBHOOK_HOST, WEBHOOK_PORT), WebhookHandler)
    log(f"Webhook server listening on {WEBHOOK_HOST}:{WEBHOOK_PORT}")
    log(f"POST http://{WEBHOOK_HOST}:{WEBHOOK_PORT}/webhook")
    log(f"Events: pull_request (opened, synchronize), issue_comment (created)")
    if not WEBHOOK_SECRET:
        warning = "WARNING: No webhook_secret configured — accepting unauthenticated requests."
        if WEBHOOK_HOST == "0.0.0.0":
            warning += " Server is bound to 0.0.0.0 (LAN-exposed). Set webhook_host: 127.0.0.1 to restrict to localhost."
        warning += " Set webhook_secret in config.yaml to secure this endpoint."
        log(warning)

    def handle_term(signum, frame):
        log("Received SIGTERM, shutting down")
        server.shutdown()

    signal.signal(signal.SIGTERM, handle_term)
    signal.signal(signal.SIGINT, handle_term)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        log("Shutting down (keyboard interrupt)")
    finally:
        server.server_close()
        try:
            os.remove(PID_FILE)
        except OSError:
            pass
        log("Webhook server stopped")


run_server()
PYTHON_EOF
