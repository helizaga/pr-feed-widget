<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.averyjennings.pr-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PR_AGENT_DIR__/bin/pr-agent</string>
        <string>poll</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PR_AGENT_HOME</key>
        <string>__PR_AGENT_HOME__</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__PR_AGENT_HOME__/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__PR_AGENT_HOME__/launchd-stderr.log</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
